{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "hugo --gc --minify --cleanDestinationDir",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.148.2"
    }
  },
  "redirects": [
    {
      "source": "/project-014",
      "destination": "https://project-14.us/",
      "permanent": true
    },
    {
      "source": "/project-014/:path*",
      "destination": "https://project-14.us/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "project-14.ai" }],
      "destination": "https://project-14.us/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.project-14.ai" }],
      "destination": "https://project-14.us/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.project-14.us" }],
      "destination": "https://project-14.us/:path*",
      "permanent": true
    },
    {
      "source": "/learning-how-magnetic-dft-converges",
      "destination": "/soc-scf-trajectories/",
      "permanent": true
    },
    {
      "source": "/learning-how-magnetic-dft-converges/:path*",
      "destination": "/soc-scf-trajectories/",
      "permanent": true
    }
  ]
}
